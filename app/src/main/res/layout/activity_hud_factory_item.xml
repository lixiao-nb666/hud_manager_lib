<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"


    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:gravity="center"
    android:orientation="vertical">



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:layout_marginTop="10px"
        android:layout_marginLeft="30px"
        android:layout_marginRight="30px"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/blue"
            android:text="@string/test_device_check"
            android:textSize="66px" />

        <TextView
            android:id="@+id/tv_device_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/blue"
            android:textSize="66px" />


        <EditText
            android:id="@+id/et_device_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20px" />



    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:layout_marginTop="10px"
        android:layout_marginLeft="30px"
        android:layout_marginRight="30px"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/blue"
            android:text="@string/test_sn_check"
            android:textSize="66px" />

        <TextView
            android:id="@+id/tv_sn_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/blue"
            android:textSize="66px" />


        <EditText
            android:id="@+id/et_sn_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20px" />



    </LinearLayout>





    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:layout_marginTop="10px"
        android:layout_marginLeft="30px"
        android:layout_marginRight="30px"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/blue"
            android:text="@string/test_version_check"
            android:textSize="66px" />

        <TextView
            android:id="@+id/tv_version_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/blue"
            android:textSize="66px" />


        <EditText
            android:id="@+id/et_version_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20px" />



    </LinearLayout>


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:background="@color/black"
        android:layout_marginTop="10px"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_sn_def"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/blue"
            android:textSize="100px" />

        <TextView
            android:id="@+id/tv_sn_other"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/red"
            android:textSize="120px" />
    </LinearLayout>


    <TextView
        android:id="@+id/tv_ble_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10px"
        android:background="@color/black"
        android:textColor="@color/blue"
        android:textSize="100px" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal">




        <Button
            android:id="@+id/bt_que_sn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/test_check_sn" />


        <Button
            android:id="@+id/bt_que_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/test_check_version" />
    </LinearLayout>









    <EditText
        android:id="@+id/et_sn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="88px"
        android:layout_marginRight="88px"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal">




        <Button
            android:id="@+id/bt_to_scan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/test_scan_get_sn" />

        <Button
            android:id="@+id/bt_rewrite_sn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/test_rewrite_sn" />
    </LinearLayout>








    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal">
    <Button
        android:id="@+id/bt_start_test"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/test_start_data_test" />

    <Button
        android:id="@+id/bt_stop_test"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/test_stop_data_test"/>

    </LinearLayout>

    <Button
        android:id="@+id/bt_to_old_mold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/test_color_change" />
    <Button
        android:id="@+id/bt_bl_auto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/test_brightness_auto" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal">


        <Button
            android:id="@+id/bt_bl_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/test_brightness_a" />

        <Button
            android:id="@+id/bt_bl_delect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/test_brightness_d"/>



    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal">


        <Button
            android:id="@+id/bt_bl_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/test_brightness_1" />

        <Button
            android:id="@+id/bt_bl_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/test_brightness_10" />



    </LinearLayout>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal">
        <Button
            android:id="@+id/bt_rg_test_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/test_light_start" />

        <Button
            android:id="@+id/bt_rg_test_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/test_light_stop"  />

    </LinearLayout>

</LinearLayout>