<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"

    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center"

    android:orientation="vertical">

    <TextView

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="30dp"
        android:background="@color/black"
        android:text="工厂测试"
        android:textColor="@color/white"
        android:textSize="120px" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_ble_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/black"
            android:textColor="@color/white"
            android:textSize="66px" />

        <TextView
            android:id="@+id/tv_ble_connect_statu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/black"
            android:textColor="@color/white"
            android:textSize="66px" />
    </LinearLayout>





    <LinearLayout
        android:id="@+id/ll_bg_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <Button
            android:id="@+id/bt_init"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_init_ble" />

        <Button
            android:id="@+id/bt_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_search_ble" />


    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_bg_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <Button
            android:id="@+id/bt_ble_disconnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="断开" />


    </LinearLayout>
    <Button
        android:id="@+id/bt_que_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="查询版本" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_ble_statu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/black"
            android:textColor="@color/white"
            android:textSize="66px" />


        <Button
            android:id="@+id/bt_que_sn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="查询SN" />
    </LinearLayout>


    <EditText
        android:id="@+id/et_sn"
        android:layout_width="800px"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal">




        <Button
            android:id="@+id/bt_to_scan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="扫码获取SN" />

        <Button
            android:id="@+id/bt_rewrite_sn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="重写SN" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <Button
            android:id="@+id/bt_bl_auto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="自动亮度" />
        <Button
            android:id="@+id/bt_bl_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="亮度+" />

        <Button
            android:id="@+id/bt_bl_delect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="亮度-" />



    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal">
        <Button
            android:id="@+id/bt_rg_test_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="光感测试开启" />

        <Button
            android:id="@+id/bt_rg_test_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="光感测试关闭"  />

    </LinearLayout>




    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal">
    <Button
        android:id="@+id/bt_start_test"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="开始测试" />

    <Button
        android:id="@+id/bt_stop_test"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="停止测试" />

    </LinearLayout>

    <Button
        android:id="@+id/bt_to_old_mold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="工厂老化模式（颜色变化）" />

</LinearLayout>